{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "devrel:arm-recorder",
  "visibility": "public",
  "url": "https://github.com/viam-devrel/arm-recorder",
  "description": "Record arm and gripper motions as named sessions, then play them back on demand",
  "applications": null,
  "markdown_link": "README.md",
  "models": [
    {
      "api": "rdk:component:sensor",
      "model": "devrel:arm-recorder:recorder",
      "markdown_link": "devrel_arm-recorder_recorder.md",
      "short_description": "Record arm and gripper motion as named sessions, then play them back"
    },
    {
      "api": "rdk:service:generic",
      "model": "devrel:arm-recorder:reactor",
      "markdown_link": "devrel_arm-recorder_reactor.md",
      "short_description": "Play recorded sessions in response to what a vision service detects"
    }
  ],
  "entrypoint": "bin/arm-recorder",
  "first_run": "",
  "build": {
    "build": "make module.tar.gz",
    "setup": "make setup",
    "path": "module.tar.gz",
    "arch": [
      "linux/amd64",
      "linux/arm64",
      "darwin/arm64",
      "windows/amd64"
    ]
  }
}
